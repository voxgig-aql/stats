# stats: descriptive, inferential, and matrix statistics in AQL.
#
# Public surface (the Stats namespace exported at the bottom). Every
# query word accepts EITHER a List of numbers OR a Summary, except the
# order-statistic words (median/quantile/iqr/mode) which need the raw
# data and so take a List only.
#
#   --- accumulator (a streaming, mergeable Summary) ---
#   xs Stats.summary            → Summary   (build from a List; [] ⇒ empty)
#   s  Stats.push x             → Summary   (mutated in place)
#   s  Stats.push-all xs        → Summary   (mutated in place)
#   a  Stats.merge b            → Summary   (union of moments, into a)
#   s  Stats.encode             → String    (jsonic snapshot)
#   text Stats.decode           → Summary   (rebuilt snapshot)
#
#   --- descriptive (List | Summary) ---
#   x Stats.count               → Integer
#   x Stats.sum                 → Float
#   x Stats.mean                → Float
#   x Stats.variance            → Float   (sample, n-1)
#   x Stats.pvariance           → Float   (population, n)
#   x Stats.stddev              → Float   (sample)
#   x Stats.pstddev             → Float   (population)
#   x Stats.min                 → Float
#   x Stats.max                 → Float
#   x Stats.range               → Float   (max - min)
#   x Stats.skewness            → Float   (biased g1)
#   x Stats.kurtosis            → Float   (biased excess, g2)
#
#   --- order statistics (List only) ---
#   xs Stats.median             → Float
#   xs Stats.quantile q         → Float   (q in [0,1], linear interpolation)
#   xs Stats.iqr                → Float   (Q3 - Q1)
#   xs Stats.mode               → Float   (most frequent; first on ties)
#
#   --- bivariate (two Lists) ---
#   xs Stats.covariance ys      → Float   (sample)
#   xs Stats.pcovariance ys     → Float   (population)
#   xs Stats.correlation ys     → Float   (Pearson r)
#   xs Stats.linreg ys          → Map     ({slope, intercept, r, r2})
#
#   --- distributions / scores ---
#   xs Stats.zscores            → List    (sample-standardised)
#   x  Stats.normal-pdf {mu,sigma} → Float
#   x  Stats.normal-cdf {mu,sigma} → Float
#
#   --- matrix / dataset (rows = observations, cols = variables) ---
#   mat Stats.col-means         → List
#   mat Stats.col-variances     → List   (sample)
#   mat Stats.col-stddevs       → List   (sample)
#   mat Stats.cov-matrix        → Matrix (sample covariance)
#   mat Stats.cor-matrix        → Matrix (correlation)
#   mat Stats.standardize       → Matrix (z-scored columns)
#   x   Stats.ols ys            → List   (least-squares coefficients)
#
# Failures raise coded errors (catch with `do […] error […]`, read
# `e get code` / `e get message` in the handler):
#
#   bad_input    empty data, too few points for the statistic, a
#                quantile out of [0,1], a non-positive sigma, or
#                mismatched vector lengths
#   needs_data   an order-statistic / bivariate word called on a Summary
#   singular     Stats.ols normal equations have no unique solution
#   bad_payload  Stats.decode text is not a Stats.encode snapshot
#
# Summary is a sealed `class` of running moments (Welford / Pébay), so
# mean/variance/skewness/kurtosis are computed in one pass and two
# Summaries merge in O(1). All arithmetic is done in Float — AQL Integer
# overflow is a hard error, not a silent wrap, so sums of squares are
# floated up front.
#
# Calling convention: the receiver/data comes first, then the verb, then
# any extra arguments, and the call is terminated with `end` (or wrapped
# in parens) — `xs Stats.mean end`. Without a terminator the verb
# swallows the following token, giving a wrong result or a dispatch error.
#
# Imported via `import "./stats.aql"`; the importing script need not
# pre-import the `aql:*` utilities (math-util, array-util, matrix-util,
# struct-util) — this module imports them itself.


import "aql:math-util"
import "aql:array-util"
import "aql:matrix-util"
import "aql:struct-util"


# --- type -----------------------------------------------------------
#
# A Summary holds the running moments of a stream: count, mean, and the
# central-moment sums m2, m3, m4 (Σ(x-mean)^k), plus the running min and
# max. Variance/skewness/kurtosis are derived from these on demand. An
# empty Summary has n = 0; min/max are seeded by the first observation.

def Summary class {
  n:    0
  mean: 0.0
  m2:   0.0
  m3:   0.0
  m4:   0.0
  min:  0.0
  max:  0.0
}


# --- numeric helpers ------------------------------------------------

# Map any List of Numbers to a List of Floats (a no-op on Floats).
def to-floats fn [
  [xs:List] [List] [
    xs each [var [[x] (x convert Float)]]
  ]
]

def sum-floats fn [
  [xs:List] [Float] [
    0.0 xs [var [[x acc] acc add (x convert Float)]] fold
  ]
]

# Ascending sort of a Float list via grade (sort indices) + at (gather).
def sorted-floats fn [
  [xs:List] [List] [
    def fs (xs to-floats)
    ArrayUtil.at (ArrayUtil.grade fs) fs
  ]
]


# --- Welford / Pébay online moment update ---------------------------
#
# Add one Float observation to a Summary, mutating it in place and
# returning the same object. The higher-moment terms (m3, m4) use the
# old m2/m3 and the old mean, so every update term is bound with `def`
# from the pre-update fields before any `set` runs.

def welford-push fn [
  [v:Float s:Summary] [Summary] [
    def n0  s.n
    def n1  (n0 add 1)
    def nf  (n1 convert Float)
    def delta (v sub s.mean)
    def dn  (delta div nf)
    def dn2 (dn mul dn)
    def t1  (delta mul dn mul (n0 convert Float))
    def mean1 (s.mean add dn)
    def m2b (s.m2 add t1)
    def m3b ((s.m3 add (t1 mul dn mul (nf sub 2.0))) sub (3.0 mul dn mul s.m2))
    def m4term (t1 mul dn2 mul (((nf mul nf) sub (3.0 mul nf)) add 3.0))
    def m4b (((s.m4 add m4term) add (6.0 mul dn2 mul s.m2)) sub (4.0 mul dn mul s.m3))
    s set mean mean1 end
    s set m2 m2b end
    s set m3 m3b end
    s set m4 m4b end
    s set n n1 end
    if (n0 eq 0) [
      s set min v end
      s set max v end
    ] [
      if (v lt s.min) [s set min v end] []
      if (v gt s.max) [s set max v end] []
    ]
    s
  ]
]

# Build a fresh Summary from a List of Numbers.
def build-summary fn [
  [xs:List] [Summary] [
    def s (make Summary {n: 0, mean: 0.0, m2: 0.0, m3: 0.0, m4: 0.0, min: 0.0, max: 0.0})
    s xs [var [[x acc] acc welford-push (x convert Float)]] fold
  ]
]

# Coerce a query argument (List or Summary) to a Summary. The union
# param plus the positive `is List` test lets the checker narrow the
# build-summary branch to List, so it type-checks cleanly whether the
# caller passes a List or an already-built Summary.
def as-summary fn [
  [x:(List tor Summary)] [Summary] [
    if (x is List) [x build-summary] [x]
  ]
]

# Guard: order-statistic / bivariate words need raw data, not a Summary.
def require-list fn [
  [x:Any] [List] [
    if (x is Summary) [
      def msg `Stats: this word needs the raw data (a List), not a Summary`
      raise needs_data msg
    ] []
    if ((x is List) not) [
      def msg `Stats: expected a List of numbers (got ${x})`
      raise bad_input msg
    ] []
    x
  ]
]

def require-n fn [
  [need:Integer s:Summary] [Summary] [
    if ((s.n gte need) not) [
      def msg `Stats: need at least ${need} value(s) (have ${s.n})`
      raise bad_input msg
    ] []
    s
  ]
]


# --- public accumulator words ---------------------------------------

def stat-push fn [
  [x:Any s:Summary] [Summary] [
    s welford-push (x convert Float)
  ]
]

def stat-push-all fn [
  [xs:List s:Summary] [Summary] [
    s xs [var [[x acc] acc welford-push (x convert Float)]] fold
  ]
]

# Parallel-combine the moments of b into a (Chan/Pébay), mutating a.
def stat-merge fn [
  [b:Summary a:Summary] [Summary] [
    def na a.n
    def nb b.n
    if (nb eq 0) [a] [
    if (na eq 0) [
      a set n nb end
      a set mean b.mean end
      a set m2 b.m2 end
      a set m3 b.m3 end
      a set m4 b.m4 end
      a set min b.min end
      a set max b.max end
      a
    ] [
      def naf (na convert Float)
      def nbf (nb convert Float)
      def nt  (na add nb)
      def ntf (nt convert Float)
      def delta (b.mean sub a.mean)
      def d2 (delta mul delta)
      def d3 (d2 mul delta)
      def d4 (d2 mul d2)
      def mean1 (a.mean add (delta mul nbf div ntf))
      def m2t ((a.m2 add b.m2) add (d2 mul naf mul nbf div ntf))
      def m3t (((a.m3 add b.m3) add (d3 mul naf mul nbf mul (naf sub nbf) div (ntf mul ntf))) add (3.0 mul delta mul ((naf mul b.m2) sub (nbf mul a.m2)) div ntf))
      def m4core (d4 mul naf mul nbf mul (((naf mul naf) sub (naf mul nbf)) add (nbf mul nbf)) div (ntf mul ntf mul ntf))
      def m4cross (6.0 mul d2 mul (((naf mul naf) mul b.m2) add ((nbf mul nbf) mul a.m2)) div (ntf mul ntf))
      def m4lin (4.0 mul delta mul ((naf mul b.m3) sub (nbf mul a.m3)) div ntf)
      def m4t ((((a.m4 add b.m4) add m4core) add m4cross) add m4lin)
      a set mean mean1 end
      a set m2 m2t end
      a set m3 m3t end
      a set m4 m4t end
      a set n nt end
      if (b.min lt a.min) [a set min b.min end] []
      if (b.max gt a.max) [a set max b.max end] []
      a
    ]]
  ]
]


# --- descriptive words (List | Summary) -----------------------------

def stat-count fn [
  [x:Any] [Integer] [
    (x as-summary) get n
  ]
]

def stat-sum fn [
  [x:Any] [Float] [
    def s (x as-summary)
    s.mean mul (s.n convert Float)
  ]
]

def stat-mean fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 1)
    s.mean
  ]
]

def stat-pvariance fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 1)
    s.m2 div (s.n convert Float)
  ]
]

def stat-variance fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 2)
    s.m2 div ((s.n sub 1) convert Float)
  ]
]

def stat-pstddev fn [
  [x:Any] [Float] [
    (x stat-pvariance) MathUtil.sqrt
  ]
]

def stat-stddev fn [
  [x:Any] [Float] [
    (x stat-variance) MathUtil.sqrt
  ]
]

def stat-min fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 1)
    s.min
  ]
]

def stat-max fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 1)
    s.max
  ]
]

def stat-range fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 1)
    s.max sub s.min
  ]
]

# Biased sample skewness g1 = (m3/n) / (m2/n)^(3/2).
def stat-skewness fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 2)
    def nf (s.n convert Float)
    def var-p (s.m2 div nf)
    if (var-p lte 0.0) [
      def msg `Stats.skewness: undefined for zero-variance data`
      raise bad_input msg
    ] []
    (s.m3 div nf) div (var-p MathUtil.sqrt mul var-p)
  ]
]

# Biased excess kurtosis g2 = (m4/n) / (m2/n)^2 - 3.
def stat-kurtosis fn [
  [x:Any] [Float] [
    def s ((x as-summary) require-n 2)
    def nf (s.n convert Float)
    def var-p (s.m2 div nf)
    if (var-p lte 0.0) [
      def msg `Stats.kurtosis: undefined for zero-variance data`
      raise bad_input msg
    ] []
    ((s.m4 div nf) div (var-p mul var-p)) sub 3.0
  ]
]


# --- order statistics (List only) -----------------------------------

# Linear-interpolated quantile (NumPy/R type-7) over sorted data.
def quantile-of fn [
  [q:Float fs:List] [Float] [
    def n (fs size)
    if (n eq 0) [
      def msg `Stats.quantile: empty data`
      raise bad_input msg
    ] []
    if ((q gte 0.0) and (q lte 1.0)) [] [
      def msg `Stats.quantile: q must be in [0, 1] (got ${q})`
      raise bad_input msg
    ]
    def sorted (fs sorted-floats)
    if (n eq 1) [sorted get 0] [
      def pos (q mul ((n sub 1) convert Float))
      def lo (pos MathUtil.floor)
      def hi (pos MathUtil.ceil)
      def frac (pos sub (lo convert Float))
      def vlo (sorted get (lo))
      def vhi (sorted get (hi))
      vlo add (frac mul (vhi sub vlo))
    ]
  ]
]

def stat-quantile fn [
  [q:Any xs:Any] [Float] [
    quantile-of (q convert Float) (xs require-list)
  ]
]

def stat-median fn [
  [xs:Any] [Float] [
    quantile-of 0.5 (xs require-list)
  ]
]

def stat-iqr fn [
  [xs:Any] [Float] [
    def fs (xs require-list)
    (quantile-of 0.75 fs) sub (quantile-of 0.25 fs)
  ]
]

# Most frequent value; on a tie the first such value in ascending order.
def stat-mode fn [
  [xs:Any] [Float] [
    def fs ((xs require-list) sorted-floats)
    if ((fs size) eq 0) [
      def msg `Stats.mode: empty data`
      raise bad_input msg
    ] []
    def seed (do {best: [fs get 0], best-count: [1], cur: [fs get 0], cur-count: [0]})
    def acc (seed fs [var [[v st]
      def same (v eq (st get cur))
      def cc (if same [(st get cur-count) add 1] [1])
      def st1 (do {best: [st get best], best-count: [st get best-count], cur: [v], cur-count: [cc]})
      if (cc gt (st1 get best-count)) [
        do {best: [v], best-count: [cc], cur: [v], cur-count: [cc]}
      ] [st1]
    ]] fold)
    acc get best
  ]
]


# --- bivariate (two Lists) ------------------------------------------

# Σ(x-mx)(y-my) over paired data, with the means computed in-pass.
def co-moment fn [
  [ys:List xs:List] [Float] [
    def fx (xs to-floats)
    def fy (ys to-floats)
    def n (fx size)
    if (n eq (fy size)) [] [
      def msg `Stats: paired data must be the same length (${n} vs ${fy size})`
      raise bad_input msg
    ]
    if (n gte 1) [] [
      def msg `Stats: paired data must be non-empty`
      raise bad_input msg
    ]
    def mx (fx sum-floats div (n convert Float))
    def my (fy sum-floats div (n convert Float))
    0.0 (iota n) [var [[i acc]
      acc add (((fx get (i)) sub mx) mul ((fy get (i)) sub my))
    ]] fold
  ]
]

def stat-pcovariance fn [
  [ys:List xs:List] [Float] [
    def c (xs co-moment ys)
    c div ((xs size) convert Float)
  ]
]

def stat-covariance fn [
  [ys:List xs:List] [Float] [
    def n (xs size)
    if (n gte 2) [] [
      def msg `Stats.covariance: need at least 2 paired values`
      raise bad_input msg
    ]
    (xs co-moment ys) div ((n sub 1) convert Float)
  ]
]

def stat-correlation fn [
  [ys:List xs:List] [Float] [
    def sx (xs stat-pstddev)
    def sy (ys stat-pstddev)
    if ((sx gt 0.0) and (sy gt 0.0)) [] [
      def msg `Stats.correlation: undefined when a variable has zero variance`
      raise bad_input msg
    ]
    def n (xs size)
    def cov-p ((xs co-moment ys) div (n convert Float))
    cov-p div (sx mul sy)
  ]
]

# Ordinary least squares for one predictor: y ≈ slope*x + intercept.
def stat-linreg fn [
  [ys:List xs:List] [Map] [
    def n (xs size)
    if (n gte 2) [] [
      def msg `Stats.linreg: need at least 2 paired values`
      raise bad_input msg
    ]
    def fx (xs to-floats)
    def fy (ys to-floats)
    def mx (fx sum-floats div (n convert Float))
    def my (fy sum-floats div (n convert Float))
    def sxx (0.0 (iota n) [var [[i acc] acc add (((fx get (i)) sub mx) mul ((fx get (i)) sub mx))]] fold)
    if (sxx gt 0.0) [] [
      def msg `Stats.linreg: predictor has zero variance`
      raise bad_input msg
    ]
    def sxy (0.0 (iota n) [var [[i acc] acc add (((fx get (i)) sub mx) mul ((fy get (i)) sub my))]] fold)
    def syy (0.0 (iota n) [var [[i acc] acc add (((fy get (i)) sub my) mul ((fy get (i)) sub my))]] fold)
    def slope (sxy div sxx)
    def intercept (my sub (slope mul mx))
    def r (if (syy gt 0.0) [sxy div ((sxx mul syy) MathUtil.sqrt)] [0.0])
    do {slope: [slope], intercept: [intercept], r: [r], r2: [r mul r]}
  ]
]


# --- distributions / scores -----------------------------------------

def stat-zscores fn [
  [xs:Any] [List] [
    def fs (xs require-list)
    def mu (fs stat-mean)
    def sd (fs stat-stddev)
    if (sd gt 0.0) [] [
      def msg `Stats.zscores: zero standard deviation`
      raise bad_input msg
    ]
    fs each [var [[x] ((x sub mu) div sd)]]
  ]
]

# erf via Abramowitz & Stegun 7.1.26 (max abs error ≈ 1.5e-7).
def erf-approx fn [
  [x:Float] [Float] [
    def sgn (if (x lt 0.0) [-1.0] [1.0])
    def ax (x MathUtil.abs convert Float)
    def t (1.0 div (1.0 add (0.3275911 mul ax)))
    def poly (t mul (0.254829592 add (t mul (-0.284496736 add (t mul (1.421413741 add (t mul (-1.453152027 add (t mul 1.061405429)))))))))
    def y (1.0 sub (poly mul ((ax mul ax) MathUtil.negate MathUtil.exp)))
    sgn mul y
  ]
]

def sigma-of fn [
  [params:Map] [Float] [
    def sigma ((params get sigma) convert Float)
    if (sigma gt 0.0) [] [
      def msg `Stats: sigma must be > 0 (got ${sigma})`
      raise bad_input msg
    ]
    sigma
  ]
]

def stat-normal-pdf fn [
  [params:Map x:Any] [Float] [
    def mu ((params get mu) convert Float)
    def sigma (params sigma-of)
    def z ((x convert Float) sub mu div sigma)
    def norm (1.0 div (sigma mul ((2.0 mul MathUtil.pi) MathUtil.sqrt)))
    norm mul ((-0.5 mul z mul z) MathUtil.exp)
  ]
]

def stat-normal-cdf fn [
  [params:Map x:Any] [Float] [
    def mu ((params get mu) convert Float)
    def sigma (params sigma-of)
    def z ((x convert Float) sub mu div sigma)
    0.5 mul (1.0 add (erf-approx (z div (2.0 MathUtil.sqrt))))
  ]
]


# --- matrix / dataset (rows = observations, cols = variables) -------

# Each column of the matrix, as a List of Lists.
def columns-of fn [
  [mat:Matrix] [List] [
    def k (MatrixUtil.cols mat)
    (iota k) each [var [[j] (mat MatrixUtil.col j)]]
  ]
]

def stat-col-means fn [
  [mat:Matrix] [List] [
    (mat columns-of) each [var [[c] (c stat-mean)]]
  ]
]

def stat-col-variances fn [
  [mat:Matrix] [List] [
    (mat columns-of) each [var [[c] (c stat-variance)]]
  ]
]

def stat-col-stddevs fn [
  [mat:Matrix] [List] [
    (mat columns-of) each [var [[c] (c stat-stddev)]]
  ]
]

# Sample covariance matrix: (1/(n-1)) Xcᵀ Xc, Xc the column-centered data.
def centered-rows fn [
  [mat:Matrix] [List] [
    def means (mat stat-col-means)
    def nrows (MatrixUtil.rows mat)
    def ncols (MatrixUtil.cols mat)
    (iota nrows) each [var [[i]
      def row (mat MatrixUtil.row i)
      (iota ncols) each [var [[j]
        ((row get (j)) sub (means get (j)))
      ]]
    ]]
  ]
]

def stat-cov-matrix fn [
  [mat:Matrix] [Matrix] [
    def nrows (MatrixUtil.rows mat)
    if (nrows gte 2) [] [
      def msg `Stats.cov-matrix: need at least 2 rows (observations)`
      raise bad_input msg
    ]
    def xc (MatrixUtil.create (mat centered-rows))
    # mat-mul X Y computes Y@X, so this is Xcᵀ @ Xc.
    def gram (MatrixUtil.mat-mul xc (MatrixUtil.transpose xc))
    MatrixUtil.scale (1.0 div ((nrows sub 1) convert Float)) gram
  ]
]

def stat-cor-matrix fn [
  [mat:Matrix] [Matrix] [
    def cov (mat stat-cov-matrix)
    def k (MatrixUtil.cols cov)
    def sds ((iota k) each [var [[i] (((cov MatrixUtil.row i) get (i)) MathUtil.sqrt)]])
    MatrixUtil.create ((iota k) each [var [[i]
      def crow (cov MatrixUtil.row i)
      (iota k) each [var [[j]
        ((crow get (j)) div ((sds get (i)) mul (sds get (j))))
      ]]
    ]])
  ]
]

def stat-standardize fn [
  [mat:Matrix] [Matrix] [
    def means (mat stat-col-means)
    def sds (mat stat-col-stddevs)
    def nrows (MatrixUtil.rows mat)
    def ncols (MatrixUtil.cols mat)
    MatrixUtil.create ((iota nrows) each [var [[i]
      def row (mat MatrixUtil.row i)
      (iota ncols) each [var [[j]
        ((row get (j)) sub (means get (j)) div (sds get (j)))
      ]]
    ]])
  ]
]


# --- linear solver + OLS --------------------------------------------
#
# Solve a square system A x = b by Gaussian elimination with partial
# pivoting. A is a List of equal-length rows (Lists); b is a List. Rows
# are copied into mutable Arrays so pivoting and elimination run in
# place. A zero pivot (within tolerance) raises `singular`.

def solve-linear fn [
  [b:List a:List] [List] [
    def n (a size)
    def rows (make Array ((iota n) each [var [[i]
      make Array ((a get (i)) each [var [[v] (v convert Float)]])
    ]]))
    def rhs (make Array (b each [var [[v] (v convert Float)]]))
    def _elim ((iota n) each [var [[col]
      # find pivot row with the largest |value| in this column
      def piv (col (iota n) [var [[r best]
        if ((r gte col) and ((((rows get (r)) get (col)) MathUtil.abs) gt (((rows get (best)) get (col)) MathUtil.abs))) [r] [best]
      ]] fold)
      def pv (((rows get (piv)) get (col)) MathUtil.abs)
      if (pv gt 0.000000001) [] [
        def msg `Stats.ols: system is singular (zero pivot at column ${col})`
        raise singular msg
      ]
      # swap pivot row into place (rows and rhs)
      def tmp-row (rows get (col))
      rows set (col) (rows get (piv)) end
      rows set (piv) (tmp-row) end
      def tmp-rhs (rhs get (col))
      rhs set (col) (rhs get (piv)) end
      rhs set (piv) (tmp-rhs) end
      # eliminate below
      def pivrow (rows get (col))
      def pivval (pivrow get (col))
      def _r ((iota n) each [var [[r]
        if (r gt col) [
          def rr (rows get (r))
          def factor ((rr get (col)) div pivval)
          def _c ((iota n) each [var [[c]
            rr set (c) ((rr get (c)) sub (factor mul (pivrow get (c)))) end
            0
          ]])
          rhs set (r) ((rhs get (r)) sub (factor mul (rhs get (col)))) end
          0
        ] [0]
      ]])
      0
    ]])
    # back-substitution into a mutable solution Array
    def x (make Array ((iota n) each [var [[i] 0.0]]))
    def _back ((iota n) each [var [[step]
      def i (n sub 1 sub step)
      def rr (rows get (i))
      def s (0.0 (iota n) [var [[j acc]
        if (j gt i) [acc add ((rr get (j)) mul (x get (j)))] [acc]
      ]] fold)
      x set (i) (((rhs get (i)) sub s) div (rr get (i))) end
      0
    ]])
    convert List x
  ]
]

# OLS coefficients for design matrix x (rows = observations, cols =
# predictors) and response ys, via the normal equations XᵀX b = Xᵀy.
# Prepend a column of 1s to x yourself for an intercept term.
def stat-ols fn [
  [ys:List x:Matrix] [List] [
    def nrows (MatrixUtil.rows x)
    if (nrows eq (ys size)) [] [
      def msg `Stats.ols: rows of X (${nrows}) must match length of y (${ys size})`
      raise bad_input msg
    ]
    # mat-mul X Y computes Y@X, so this is Xᵀ @ X.
    def xtx (MatrixUtil.mat-mul x (MatrixUtil.transpose x))
    def k (MatrixUtil.cols x)
    def fy (ys to-floats)
    def xty ((iota k) each [var [[j] (MatrixUtil.dot (x MatrixUtil.col j) fy)]])
    def arows ((iota k) each [var [[i] xtx MatrixUtil.row i]])
    arows solve-linear xty
  ]
]


# --- encode / decode ------------------------------------------------
#
# Snapshot a Summary as a jsonic String (every moment field) and rebuild
# it. Reads on decode are strict; any malformation re-raises as one
# bad_payload error.

def stat-encode fn [
  [s:Summary] [String] [
    def payload (do {
      n:    [s.n]
      mean: [s.mean]
      m2:   [s.m2]
      m3:   [s.m3]
      m4:   [s.m4]
      min:  [s.min]
      max:  [s.max]
    })
    `${payload}`
  ]
]

def stat-decode fn [
  [text:String] [Summary] [
    def payload (do [StructUtil.parse text] error [
      def msg `Stats.decode: payload is not parseable jsonic`
      raise bad_payload msg
    ])
    do [
      # Coerce field types: jsonic renders whole-valued Floats without a
      # decimal point, so a parsed moment can come back as an Integer.
      make Summary {
        n:    ((payload !. n) convert Integer)
        mean: ((payload !. mean) convert Float)
        m2:   ((payload !. m2) convert Float)
        m3:   ((payload !. m3) convert Float)
        m4:   ((payload !. m4) convert Float)
        min:  ((payload !. min) convert Float)
        max:  ((payload !. max) convert Float)
      }
    ] error [
      def msg `Stats.decode: payload is not a Stats.encode snapshot (need integer n, floats mean m2 m3 m4 min max)`
      raise bad_payload msg
    ]
  ]
]


# --- namespace ------------------------------------------------------
#
# Functions are exported with `/r` so the auto-evaluating map literal
# doesn't dispatch them at construction time. The Summary type goes in
# bare.

export "Stats" {
  Summary
  summary:      build-summary/r
  push:         stat-push/r
  push-all:     stat-push-all/r
  merge:        stat-merge/r
  encode:       stat-encode/r
  decode:       stat-decode/r

  count:        stat-count/r
  sum:          stat-sum/r
  mean:         stat-mean/r
  variance:     stat-variance/r
  pvariance:    stat-pvariance/r
  stddev:       stat-stddev/r
  pstddev:      stat-pstddev/r
  min:          stat-min/r
  max:          stat-max/r
  range:        stat-range/r
  skewness:     stat-skewness/r
  kurtosis:     stat-kurtosis/r

  median:       stat-median/r
  quantile:     stat-quantile/r
  iqr:          stat-iqr/r
  mode:         stat-mode/r

  covariance:   stat-covariance/r
  pcovariance:  stat-pcovariance/r
  correlation:  stat-correlation/r
  linreg:       stat-linreg/r

  zscores:      stat-zscores/r
  normal-pdf:   stat-normal-pdf/r
  normal-cdf:   stat-normal-cdf/r

  col-means:    stat-col-means/r
  col-variances: stat-col-variances/r
  col-stddevs:  stat-col-stddevs/r
  cov-matrix:   stat-cov-matrix/r
  cor-matrix:   stat-cor-matrix/r
  standardize:  stat-standardize/r
  ols:          stat-ols/r
}
